{
  "openapi": "3.1.0",
  "info": {
    "title": "Freedom CQA Backend",
    "description": "Local transcript evaluation, bounded LLM cascade, immutable checklists, evidence validation, SQLite and human appeal decisions. No frontend or ASR.",
    "version": "2.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health",
        "description": "Configuration presence is not a live provider access/balance check.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/conversations/import": {
      "post": {
        "tags": [
          "Conversations"
        ],
        "summary": "Import Conversations",
        "description": "Atomically import organizer JSON. Same ID/content is skipped; changed content returns 409.",
        "operationId": "import_conversations_api_conversations_import_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ImportData"
                  },
                  {
                    "$ref": "#/components/schemas/OrganizerResponse"
                  }
                ],
                "title": "Payload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations": {
      "get": {
        "tags": [
          "Conversations"
        ],
        "summary": "List Conversations",
        "operationId": "list_conversations_api_conversations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/conversations/{conversation_id}": {
      "get": {
        "tags": [
          "Conversations"
        ],
        "summary": "Get Conversation",
        "description": "Immutable source messages with stable message_id and evaluation history.",
        "operationId": "get_conversation_api_conversations__conversation_id__get",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Conversation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/checklists": {
      "get": {
        "tags": [
          "Checklists"
        ],
        "summary": "Checklists",
        "operationId": "checklists_api_checklists_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Checklists"
        ],
        "summary": "Save Checklist",
        "operationId": "save_checklist_api_checklists_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChecklistRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/checklists/{checklist_hash}": {
      "get": {
        "tags": [
          "Checklists"
        ],
        "summary": "Get Checklist",
        "operationId": "get_checklist_api_checklists__checklist_hash__get",
        "parameters": [
          {
            "name": "checklist_hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Checklist Hash"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/evaluations/{evaluation_id}/appeals": {
      "get": {
        "tags": [
          "Appeals"
        ],
        "summary": "List Appeals",
        "operationId": "list_appeals_api_evaluations__evaluation_id__appeals_get",
        "parameters": [
          {
            "name": "evaluation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Evaluation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Appeals"
        ],
        "summary": "Create Appeal",
        "operationId": "create_appeal_api_evaluations__evaluation_id__appeals_post",
        "parameters": [
          {
            "name": "evaluation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Evaluation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppealRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/appeals/{appeal_id}/resolve": {
      "post": {
        "tags": [
          "Appeals"
        ],
        "summary": "Resolve Appeal",
        "operationId": "resolve_appeal_api_appeals__appeal_id__resolve_post",
        "parameters": [
          {
            "name": "appeal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Appeal Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/evaluations": {
      "post": {
        "tags": [
          "Evaluations"
        ],
        "summary": "Start Evaluation",
        "operationId": "start_evaluation_api_evaluations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationResponse"
                }
              }
            }
          },
          "200": {
            "description": "Cached terminal evaluation; no new model call."
          },
          "503": {
            "description": "Model not configured or service is shutting down."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/evaluations/{evaluation_id}": {
      "get": {
        "tags": [
          "Evaluations"
        ],
        "summary": "Get Evaluation",
        "operationId": "get_evaluation_api_evaluations__evaluation_id__get",
        "parameters": [
          {
            "name": "evaluation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Evaluation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppealRequest": {
        "properties": {
          "criterion_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Criterion Id"
          },
          "comment": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Comment"
          },
          "author": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Author"
          },
          "client_request_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Client Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "criterion_id",
          "comment",
          "author",
          "client_request_id"
        ],
        "title": "AppealRequest"
      },
      "ChecklistRequest": {
        "properties": {
          "checklist": {
            "additionalProperties": true,
            "type": "object",
            "title": "Checklist"
          },
          "parent_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Hash"
          },
          "author": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Author"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "checklist",
          "author"
        ],
        "title": "ChecklistRequest"
      },
      "ConversationInput": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Conversation Id"
          },
          "language": {
            "type": "string",
            "enum": [
              "RU",
              "KZ",
              "EN"
            ],
            "title": "Language"
          },
          "channel": {
            "type": "string",
            "enum": [
              "agent chat",
              "voice call"
            ],
            "title": "Channel"
          },
          "transcript": {
            "items": {
              "$ref": "#/components/schemas/MessageInput"
            },
            "type": "array",
            "maxItems": 10000,
            "minItems": 1,
            "title": "Transcript"
          },
          "audio_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio Url"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "language",
          "channel",
          "transcript"
        ],
        "title": "ConversationInput"
      },
      "DecisionRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "uphold",
              "change"
            ],
            "title": "Decision"
          },
          "reason": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Reason"
          },
          "reviewer": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Reviewer"
          },
          "replacement": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replacement"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "client_request_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Client Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "reason",
          "reviewer",
          "expected_revision",
          "client_request_id"
        ],
        "title": "DecisionRequest"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "EvaluationRequest": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Conversation Id"
          },
          "checklist_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Checklist Hash"
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "description": "Creates a new paid attempt only after previous work is finished. An active duplicate always returns the same ID.",
            "default": false
          },
          "pipeline_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pipeline Hash",
            "description": "Optional experiment guard; changed server configuration returns 409 before any model call."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_id",
          "checklist_hash"
        ],
        "title": "EvaluationRequest"
      },
      "EvaluationResponse": {
        "properties": {
          "evaluation_id": {
            "type": "string",
            "title": "Evaluation Id"
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "checklist_hash": {
            "type": "string",
            "title": "Checklist Hash"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "needs_review",
              "error"
            ],
            "title": "Status"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result",
            "description": "Baseline run. Use result.final_summary.score for the main score; null is valid. Exact fields and synthetic samples are supplied in FRONTEND_INTEGRATION.md and examples/."
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "inference": {
            "additionalProperties": true,
            "type": "object",
            "title": "Inference",
            "description": "Requested/actual model, normalized usage, calls and duration; no credentials."
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "revision": {
            "type": "integer",
            "title": "Revision",
            "default": 0
          },
          "review_status": {
            "type": "string",
            "enum": [
              "none",
              "open",
              "resolved"
            ],
            "title": "Review Status",
            "default": "none"
          },
          "pipeline": {
            "type": "string",
            "title": "Pipeline",
            "default": "single"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "stages": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Stages"
          },
          "pipeline_snapshot": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pipeline Snapshot"
          },
          "routing": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Routing"
          },
          "disagreements": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Disagreements"
          }
        },
        "type": "object",
        "required": [
          "evaluation_id",
          "conversation_id",
          "checklist_hash",
          "status",
          "result",
          "error",
          "inference",
          "created_at",
          "updated_at"
        ],
        "title": "EvaluationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportData": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/ConversationInput"
            },
            "type": "array",
            "maxItems": 2000,
            "minItems": 1,
            "title": "Records"
          },
          "total_records": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Records"
          },
          "dataset_group_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dataset Group Id"
          }
        },
        "type": "object",
        "required": [
          "records"
        ],
        "title": "ImportData"
      },
      "MessageInput": {
        "properties": {
          "timestamp": {
            "type": "string",
            "minLength": 1,
            "title": "Timestamp",
            "description": "Original MM:SS for chats or timezone-aware ISO 8601 for calls. Never converted."
          },
          "speaker": {
            "type": "string",
            "enum": [
              "client",
              "operator",
              "bot",
              "system"
            ],
            "title": "Speaker"
          },
          "text": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "speaker",
          "text"
        ],
        "title": "MessageInput"
      },
      "OrganizerResponse": {
        "properties": {
          "isSuccess": {
            "type": "boolean",
            "title": "Issuccess"
          },
          "data": {
            "$ref": "#/components/schemas/ImportData"
          },
          "error": {
            "type": "string",
            "title": "Error",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "isSuccess",
          "data"
        ],
        "title": "OrganizerResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}