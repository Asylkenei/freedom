CQA_API_KEY=
CQA_MODEL=gpt-6.1-sol
CQA_PIPELINE=single
# Optional cascade, enabled only with CQA_PIPELINE=cascade.
CQA_SMALL_MODEL=gpt-6-luna
CQA_REVIEW_MODEL=gpt-6.1-sol
CQA_REVIEW_ALL=false
CQA_AUDIT_RATE=0.10
CQA_AUDIT_SEED=cqa-audit-v1
CQA_SENSITIVE_CRITERIA=c03
CQA_BASE_URL=https://api.openai.com/v1
CQA_DATA_DIR=data
CQA_TIMEOUT_SECONDS=120
# Optional local knowledge JSON; empty means no external product reference.
CQA_KNOWLEDGE_FILE=
# Comma-separated browser origins; credentials/cookies are not used.
CQA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
